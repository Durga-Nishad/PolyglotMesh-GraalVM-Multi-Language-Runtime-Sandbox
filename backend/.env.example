# Copy this file to ".env" and change the values. (Never push ".env" to GitHub.)

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

SANDBOX_TIMEOUT_MS=5000
SANDBOX_MAX_CODE_LENGTH=20000
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_STATEMENT_LIMIT=20000000
SANDBOX_MAX_CONCURRENT=4
SANDBOX_ALLOWED_LANGUAGES=python,javascript

COMPARE_DEFAULT_ITERATIONS=5
COMPARE_MAX_ITERATIONS=25

LOG_LEVEL=INFO

# Run a tiny script in each language after start-up so the first run is fast (true/false)
POLYGLOT_WARMUP=true
